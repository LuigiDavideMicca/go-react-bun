{
  "name": "borgo-framework",
  "version": "0.9.0",
  "description": "Mini Vercel-style fullstack framework: file-based React SSR on Bun, API routes in Go, one binary + one server, self-hosted.",
  "type": "module",
  "bin": {
    "borgo": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./refresh-runtime": "./src/refresh-runtime.ts",
    "./router": "./src/router.ts",
    "./runtime": "./src/runtime.ts",
    "./server": "./src/server.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "sass": "^1.93.0",
    "react-refresh": "^0.16.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "author": "Luigi Davide Micca <luigimicca94@gmail.com> (https://luigimicca.com)",
  "license": "MIT",
  "homepage": "https://github.com/LuigiDavideMicca/borgo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuigiDavideMicca/borgo.git",
    "directory": "packages/borgo"
  },
  "keywords": [
    "react",
    "ssr",
    "go",
    "golang",
    "bun",
    "framework",
    "fullstack",
    "self-hosted",
    "typescript",
    "code-generation",
    "file-based-routing",
    "islands",
    "websockets",
    "sse",
    "fast-refresh",
    "nextjs-alternative"
  ]
}
